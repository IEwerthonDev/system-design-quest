# System Design Quest — environment variables (Hobby / local)
# Copy to `.env` / `.env.local` as needed. Do not commit secrets.

# --- Vercel KV (sessions + leaderboard; required for durable Hobby path) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional aliases some Vercel templates also set:
# KV_URL=
# KV_REST_API_READ_ONLY_TOKEN=

# --- Optional Vercel Blob (export upload; client download works without this) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional Edge Config (maintenance / promo flags; fail-open when unset) ---
# Connection string from Vercel Edge Config. Client reads via VITE_EDGE_CONFIG.
EDGE_CONFIG=
VITE_EDGE_CONFIG=

# --- Cron (daily cleanup + judge warm-up) ---
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- AI Judge (hybrid: real LLM when key set, else mock) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Force mock even when LLM_API_KEY is set:
# JUDGE_USE_MOCK=true

# --- Client API base (optional; defaults to same-origin /api on Hobby) ---
# VITE_API_URL=
# VITE_SESSIONS_MODE=local

# --- Neon Postgres ---
# NOT used. Hobby history/progress/stats are served by KV + client storage (NEON-01).
# Do not add DATABASE_URL / Neon vars unless a documented KV query gap appears.
