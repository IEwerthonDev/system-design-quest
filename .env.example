# LLM API (optional on Hobby — mock judge used when unset)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Force mock even when LLM_API_KEY is set (CI/demo)
JUDGE_USE_MOCK=

# Server (local Fastify)
PORT=3000

# Optional external API base for sessions/leaderboard client calls
VITE_API_URL=
# Force sessions to localStorage (Hobby default: auto-fallback on 404)
VITE_SESSIONS_MODE=

# Database (Phase 4+)
DATABASE_URL=file:./dev.db

# GitHub OAuth (optional — Phase 4+)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
