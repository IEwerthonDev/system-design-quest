{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/judge.js": {
      "maxDuration": 60
    },
    "api/sessions.js": {
      "maxDuration": 30
    },
    "api/leaderboard.js": {
      "maxDuration": 30
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/sessions/:id", "destination": "/api/sessions?id=:id" },
    { "source": "/api/leaderboard/:problemId", "destination": "/api/leaderboard?problemId=:problemId" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
